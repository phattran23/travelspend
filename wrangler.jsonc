{
  "name": "travelspend",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travelspend",
      "database_id": "f2d1937c-71af-4961-9323-1137efe0028b"
    }
  ]
}
