{
  "name": "travel-wallet",
  "version": "1.1.0",
  "description": "Travel Wallet — group trip funds, shared expenses and settlements in VND",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:dev": "wrangler dev",
    "cf:db": "wrangler d1 execute travelspend --remote --file=worker/schema.sql",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22.5"
  },
  "type": "module"
}